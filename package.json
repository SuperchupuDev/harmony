{
  "name": "@superchupu/harmony",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "build": "tsc",
    "check": "biome check",
    "check:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "lint": "biome lint",
    "start": "node --env-file=.env --enable-source-maps dist/index.js",
    "test": "node --run check && node --run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "discord-api-types": "^0.38.48",
    "hono": "^4.12.23",
    "say": "^0.16.0",
    "typed-env": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.4.0",
      "onFail": "download"
    }
  }
}
